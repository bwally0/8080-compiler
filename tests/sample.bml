var uint8 num1;
var int8 num2;

var uint16 num3;
var int16 num4;

var char char1;
var bool bool1;

var uint8 i;

var uint8 n1;
var uint8 n2;

var uint8 f1;
var uint8 f2;

var uint8 r1;

func main() -> void {
    num1 = 1;
    num2 = -10;

    i = 0;
    while (i < 3) {
        i = i + 1;
    }

    num1 = fibonacci(num1);

    bool1 = 1 && 0;
    bool1 = 0 == 0;
    bool1 = 1 || 0;
    bool1 = 1 ^ 1;
    bool1 = 1 != 0;
}

func fibonacci(uint8 num) -> uint8 {
    if (num <= 1) {
        ret num;
    }

    n1 = num - 1;
    n2 = num - 2;
    
    f1 = fibonacci(n1);
    f2 = fibonacci(n2);

    r1 = f1 + f2;

    ret r1;
}

