/* global variables */
var uint8 n;
var uint8 f1;
var uint8 f2;
var uint8 r1;
var uint8 i; 

/* main function */
func main() -> uint8 {
    n = fibonacci(4);
    ret 0;
}

/* fibonacci function */
func fibonacci(uint8 num) -> uint8 {
    if (num < 2) {
        ret num;
    }

    f1 = 0;
    f2 = 1;
    i = 1;

    while (i < num) {
        r1 = f1 + f2;
        f1 = f2;
        f2 = r1;
        i = i + 1;
    }

    ret f2;
}